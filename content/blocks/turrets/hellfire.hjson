type: ItemTurret 
name: Hellfire
description: Come out and play, let it rain down hellfire
reload: 3
shootCone: 4
rotateSpeed: 2
size: 4
range: 150
health: 1200
inaccuracy: 2

shootSound: flame
outlineIcon: true
maxAmmo: 300
ammoPerShot: 1

targetInterval: 6
recoil: 0

ammoTypes: {
  pyratite: {
    shootEffect: shootPyraFlame
    hitEffect: hitFlameSmall
    despawnEffect: none
    trailEffect: incendTrail
    trailChance: 1
    trailParam: 4
    trailSpread: 3
    trailColor: ff9b42
    collidesAir: false
    speed: 4
    hitSize: 7
    lifetime: 30
    damage: 60
    ammoMultiplier: 1
    reloadMultiplier: 1
    pierce: true
    hittable: false
    status: burning
    statusDuration: 600
    shootSound: shootFlame
  }
}

drawer: {
  type: DrawTurret
  parts: [
    {
      type: EffectSpawnerPart
      effect: shootPyraFlame

      x: 8
      y: 0
      width: 0
      height: 0
      mirror: true

      effectRot: 90
      effectRandRot: 10

      effectInterval: 3
      effectChance: 1

      useProgress: true
      progress: reload
    }
  ]
}

consumes: {
  liquids: [
     oil/1.2
]
}

requirements: [
  silicon/2000
  phase-fabric/1000
  2stygium/1200
  1ceramic-composite/900
  2magnetite/300
]

category: turret
